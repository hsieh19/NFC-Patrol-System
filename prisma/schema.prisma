generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  code        String       @id
  name        String
  permissions String       @default("[]")
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkpoints Checkpoint[]
  plans       Plan[]
  routes      Route[]
  users       User[]
}

model User {
  id         String         @id @default(cuid())
  username   String?        @unique
  password   String?
  name       String
  avatar     String?
  department String?
  roleCode   String         @default("OPERATOR")
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  groupId    String?
  patrols    PatrolRecord[]
  archivedPatrols PatrolRecordArchive[] @relation("ArchiveUser")
  repairs    RepairReport[]
  group      UserGroup?     @relation(fields: [groupId], references: [id])
  role       Role           @relation(fields: [roleCode], references: [code], onDelete: SetDefault)
  patrolWand PatrolWand?    @relation("UserWand")
}

model UserGroup {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  checkpoints Checkpoint[]
  plans       Plan[]
  routes      Route[]
  users       User[]
}

model SystemConfig {
  id            Int      @id @default(autoincrement())
  isInitialised Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model Checkpoint {
  id         String            @id @default(cuid())
  nfcTagId   String            @unique
  name       String
  location   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  cardType   String            @default("IC") // 巡检点卡片类型，"IC" (13.56MHz) 或 "ID" (125KHz)
  groupId    String
  roleCode   String
  role       Role              @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  group      UserGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  records    PatrolRecord[]
  archivedRecords PatrolRecordArchive[] @relation("ArchiveCheckpoint")
  repairs    RepairReport[]
  routeLinks RouteCheckpoint[]

  @@index([groupId])
  @@index([roleCode])
}

model Route {
  id          String            @id @default(cuid())
  name        String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  groupId     String
  roleCode    String
  plans       Plan[]
  role        Role              @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  group       UserGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  checkpoints RouteCheckpoint[]

  @@index([groupId])
  @@index([roleCode])
}

model RouteCheckpoint {
  id           String     @id @default(cuid())
  routeId      String
  checkpointId String
  order        Int        @default(0)
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  route        Route      @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, checkpointId])
}

model Plan {
  id         String    @id @default(cuid())
  name       String
  routeId    String
  startTime  String
  endTime    String
  assignedTo String?
  frequency  String    @default("DAILY")
  planType   String    @default("ORDERED")
  groupId    String
  roleCode   String
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  role       Role      @relation(fields: [roleCode], references: [code], onDelete: Cascade)
  group      UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  route      Route     @relation(fields: [routeId], references: [id])

  @@index([groupId])
  @@index([routeId])
}

model PatrolRecord {
  id                 String      @id @default(cuid())
  checkpointId       String?
  checkpointName     String?
  checkpointLocation String?
  userId             String
  status             String      @default("NORMAL")
  notes              String?
  offlineId          String?     @unique
  createdAt          DateTime    @default(now())
  user               User        @relation(fields: [userId], references: [id])
  checkpoint         Checkpoint? @relation(fields: [checkpointId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([checkpointId, createdAt])
  @@index([status, createdAt])
}

model PatrolRecordArchive {
  id                 String      @id @default(cuid())
  checkpointId       String?
  checkpointName     String?
  checkpointLocation String?
  userId             String
  status             String      @default("NORMAL")
  notes              String?
  offlineId          String?     @unique
  createdAt          DateTime    @default(now())
  user               User        @relation("ArchiveUser", fields: [userId], references: [id])
  checkpoint         Checkpoint? @relation("ArchiveCheckpoint", fields: [checkpointId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([checkpointId, createdAt])
  @@index([status, createdAt])
}

model RepairReport {
  id           String      @id @default(cuid())
  checkpointId String?
  userId       String
  description  String
  imageUrls    String?
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])
  checkpoint   Checkpoint? @relation(fields: [checkpointId], references: [id])

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PatrolWand {
  id         String     @id @default(cuid())
  uuid       String     @unique // 巡更棒的唯一通信授权 UUID
  name       String     // 设备名称
  cardType   String     @default("IC") // 读卡器模式，"IC" 或 "ID"
  ipAddress  String?    // 设备最新的局域网 IP
  lastSeen   DateTime?  // 最新在线时间 (心跳接收时间)
  userId     String?    @unique // 分配的人员 ID (一对一绑定)
  shouldWakeServer Boolean @default(false) // 是否需要唤醒本地 Web 服务的标志
  user       User?      @relation("UserWand", fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
}

